{
  "name": "nextish-express-router",
  "version": "0.1.0",
  "description": "Directory-based routing (Next.js style) as an Express wrapper — TypeScript first.",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./zod": {
      "types": "./dist/src/zod.d.ts",
      "default": "./dist/src/zod.js"
    },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "zod": ["dist/src/zod.d.ts"]
    }
  },
  "files": [
    "dist/src"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "node --watch --import tsx example/server.ts",
    "start": "node -e \"process.env.NODE_ENV='production'; require('./dist/example/server.js')\"",
    "todo:dev": "node --watch --import tsx example/todo/server.ts",
    "todo:start": "node -e \"process.env.NODE_ENV='production'; require('./dist/example/todo/server.js')\"",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test",
    "prepack": "npm run build"
  },
  "keywords": [
    "express",
    "routing",
    "nextjs",
    "directory-routing",
    "typescript"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "chokidar": "^4.0.3",
    "path-to-regexp": "^8.4.2"
  },
  "peerDependencies": {
    "@types/express": "^4.17.25 || ^5.0.0",
    "express": "^4.22.3 || ^5.0.0",
    "zod": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "@types/express": {
      "optional": true
    },
    "zod": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^4.17.25",
    "@types/node": "^20.19.43",
    "eslint": "^10.13.0",
    "express": "^4.22.3",
    "express5": "npm:express@^5.3.0",
    "globals": "^17.13.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.0",
    "zod": "^4.6.7"
  }
}
